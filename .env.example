# MongoDB Atlas connection string (replace user, password and cluster)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/shaqodoon?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-text
PORT=5000
# Admin account created automatically on first start
ADMIN_EMAIL=admin@shaqodoon.so
ADMIN_PASSWORD=Admin12345
